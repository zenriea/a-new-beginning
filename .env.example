# ---- copy to .env and fill in. Never commit .env ----

# Operator password for the web UI (required for remote access; without it only localhost is served).
# At least 12 characters. QuantDesk refuses to start with a shorter password or a value copied from the docs.
QD_ADMIN_PASSWORD=
# Random string used to sign session cookies (generate: python3 -c "import secrets;print(secrets.token_hex(32))")
QD_SESSION_SECRET=
# Set to 1 when served over HTTPS (Caddy profile or your own proxy)
QD_COOKIE_SECURE=0

# ---- AI analyst (optional). With none configured, the labelled DEMO rules analyst runs at $0. ----
# Any OpenAI-compatible chat API works. Uncomment ONE block:
#
# OpenAI
# QD_LLM_PROVIDER=openai
# QD_LLM_BASE_URL=https://api.openai.com/v1
# QD_LLM_API_KEY=sk-...
# QD_LLM_MODEL=<model name from your OpenAI account>
#
# Google Gemini (has a free tier) - OpenAI-compatible endpoint
# QD_LLM_PROVIDER=gemini
# QD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# QD_LLM_API_KEY=<key from aistudio.google.com>
# QD_LLM_MODEL=gemini-3.5-flash   # verified working Nov 2026; Pro models need billing (free-tier quota is 0)
#
# Groq / OpenRouter / Mistral / DeepSeek / Together: same pattern with their base URL, key and model.
#
# Local model with Ollama (free, no key; needs a machine that can run the model)
# QD_LLM_PROVIDER=ollama
# QD_LLM_BASE_URL=http://localhost:11434/v1
# QD_LLM_MODEL=<model you pulled, e.g. a 7B-14B instruct model>
#
# Prices per 1M tokens for your model, used for the spending cap (check your provider's price list)
# QD_LLM_PRICE_IN=5
# QD_LLM_PRICE_OUT=20
#
# Or Claude (Anthropic):
# ANTHROPIC_API_KEY=
# QD_LLM_MODEL=claude-opus-5-5
QD_LLM_EFFORT=medium
QD_LLM_FALLBACKS=1
# Used only to disclose possible hindsight leakage in backtests; set to your model's documented training cutoff.
QD_LLM_KNOWLEDGE_CUTOFF=2026-06-01

# NASDAQ data: free Alpaca account -> Paper/Live API keys (market data only; no orders are ever sent to Alpaca)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# realtime quote feed: iex (free plan) or sip (paid plan)
ALPACA_FEED=iex

# live = real market data; synthetic = labelled fake data for demos/tests
QD_MARKET_DATA=live

# Docker: domain for automatic HTTPS (only with `--profile tls`)
QD_DOMAIN=desk.example.com

# Free helper models (optional). Each key switches one on. Hypotheses, repairs, reviews and
# questions go to these first (cost $0); the main model above is the fallback. An "allocate"
# decision also needs a second opinion from one of them before capital moves.
# GEMINI_API_KEY=        # aistudio.google.com/apikey   model: QD_GEMINI_MODEL (default gemini-3.8-flash)
# GROQ_API_KEY=          # console.groq.com/keys        model: QD_GROQ_MODEL (default openai/gpt-oss-120b)
# OPENROUTER_API_KEY=    # openrouter.ai/keys           model: QD_OPENROUTER_MODEL (default openai/gpt-oss-120b:free)
